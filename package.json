{
  "name": "modular-ui-kit-vue",
  "version": "2.0.0",
  "license": "MIT",
  "keywords": [
    "vue",
    "vue3",
    "vue-components",
    "ui-kit",
    "component-library",
    "typescript",
    "pinia",
    "sass",
    "design-system",
    "frontend",
    "responsive-ui"
  ],
  "homepage": "https://github.com/eugenia-vitinschii/modular-ui-kit-vue/tree/build/npm-package#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eugenia-vitinschii/modular-ui-kit-vue.git"
  },
  "bugs": {
    "url": "https://github.com/eugenia-vitinschii/modular-ui-kit-vue/issues"
  },
  "author": "vitinschii.eugenia@gmail.com",
  "description": "A modular, lightweight UI kit built with Vue 3, Pinia, and TypeScript.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./dist/modular-ui-kit-vue.css": "./dist/modular-ui-kit-vue.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build && cp src/index.d.ts dist/index.d.ts",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "run-s \"lint:*\"",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "format": "prettier --write --experimental-cli src/"
  },
  "peerDependencies": {
    "pinia": "^3.0.4",
    "vue": "^3.5.38",
    "vue-router": "^4.6.4"
  },
  "dependencies": {
    "axios": "^1.18.0"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.4",
    "@types/node": "^24.13.2",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/eslint-config-typescript": "^14.8.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.69.0",
    "eslint-plugin-vue": "~10.9.2",
    "jiti": "^2.7.0",
    "npm-run-all2": "^9.0.2",
    "oxlint": "~1.69.0",
    "prettier": "3.8.4",
    "sass": "^1.101.0",
    "typescript": "~6.0.0",
    "vite": "^8.0.16",
    "vite-plugin-vue-devtools": "^8.1.2",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.5"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  }
}
